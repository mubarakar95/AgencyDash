# ==============================================================================
# AgencyDash Environment Configuration
# ==============================================================================
# Copy this file to .env.local and populate the values below with your credentials.
#
# cp .env.example .env.local
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Required for server-side admin tasks and migrations)
# Keep this secret! Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Public Application URL (used for Auth redirects and Client Portal links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
